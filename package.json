{
  "name": "uburoom",
  "version": "0.5.3",
  "private": true,
  "description": "Self-hosted Plex watch parties with a web interface and Discord integration",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "doctor": "node scripts/doctor.js",
    "pretest": "node scripts/new-dev-cert.js --if-missing",
    "test": "node --test --test-reporter=dot tests/*.test.js",
    "test:full": "node --test tests/*.test.js",
    "test:playback": "node scripts/playback-baseline.js",
    "sync:bench": "node scripts/sync-bench.js",
    "demo": "node scripts/watch-demo.js",
    "traces:record": "node scripts/record-room-traces.js",
    "build:player": "node scripts/build-player-vendor.js && node scripts/build-subtitle-vendor.js",
    "format": "prettier --write server shared web scripts tests",
    "format:check": "prettier --check server shared web scripts tests",
    "lint": "eslint server shared web scripts tests",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "discord.js": "^14.22.1",
    "hls.js": "^1.7.3",
    "jassub": "2.5.21",
    "libbitsub": "1.13.0",
    "ws": "^8.18.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "license": "GPL-3.0-only"
}
