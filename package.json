{
  "name": "uburoom",
  "version": "0.5.3",
  "private": true,
  "description": "Self-hosted Plex watch parties with a web interface and Discord integration",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test --test-reporter=dot tests/*.test.js",
    "test:full": "node --test tests/*.test.js",
    "test:playback": "node scripts/playback-baseline.js",
    "demo": "node scripts/watch-demo.js",
    "build:player": "node scripts/build-player-vendor.js && node scripts/build-subtitle-vendor.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "discord.js": "^14.22.1",
    "hls.js": "^1.7.3",
    "jassub": "2.5.21",
    "libbitsub": "1.13.0",
    "ws": "^8.18.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "license": "GPL-3.0-only"
}
