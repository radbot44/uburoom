# Supply your own server HTTPS origin and private provider settings.
HOST=127.0.0.1
PORT=6767
PUBLIC_URL=https://localhost:6767
TLS_CERT=certs/server-cert.pem
TLS_KEY=certs/server-key.pem
# Optional; blank starts the local setup server without Discord.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=
DISCORD_COMMAND_CHANNEL_IDS=
# Room defaults: comma-separated capability names, "all", or "none".
# Blank: hosts have ordinary rights except deletion; viewers have playPause.
# Hosts inherit viewer grants. Creator-only host/permission/creatorship management
# cannot be granted through these lists. Personal player choices stay personal.
# Names: playPause,seek,chooseMedia,addQueue,editQueue,autoplay,picture,
# roomSettings,closeRoom,deleteRoom,continueWithoutHost
ROOM_HOST_PERMISSIONS=
ROOM_VIEWER_PERMISSIONS=
# Additional room administrators: exact provider user IDs / guild role IDs.
# These users must explicitly enable top-bar Admin mode for creator rights.
# This does not grant operator account-matching or device-pairing authority.
ROOM_ADMIN_DISCORD_IDS=
ROOM_ADMIN_PLEX_IDS=
ROOM_ADMIN_DISCORD_ROLE_IDS=
# Plex on the same machine. Keep its token in this private server file.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
# Optional exact Plex server machine ID. Otherwise pinned at first successful verification.
PLEX_MACHINE_IDENTIFIER=
# Optional absolute path OUTSIDE this shared project; default is the server user's
# LOCALAPPDATA\uburoom\credentials.key. Back up that key separately with data/accounts.sqlite.
UBUROOM_CREDENTIAL_KEY_FILE=
# Optional AV1 fallback: paths to EXISTING binaries on the actual server.
# Used for embedded subtitle extraction and optional AV1. Run scripts/av1-probe.js
# before using AV1 hardware conversion; subtitle stream-copy needs no encoder probe.
FFMPEG_PATH=
# Defaults to ffprobe beside FFMPEG_PATH.
FFPROBE_PATH=
