{
  "manifest_version": 3,
  "name": "uburoom",
  "version": "0.4.14",
  "description": "Local YouTube TV picture controls and remote access with per-tab Discord sharing settings.",
  "browser_specific_settings": {
    "gecko": {
      "id": "uburoom@uburoom.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "sessions"
  ],
  "host_permissions": [
    "https://tv.youtube.com/*",
    "https://localhost/*"
  ],
  "background": {
    "scripts": [
      "engine.js",
      "server-config.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "uburoom — remote off by default",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/uburoom-icon-16.png",
      "32": "assets/uburoom-icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://tv.youtube.com/*"
      ],
      "js": [
        "engine.js",
        "remote-ui.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/uburoom-wordmark-brand.svg"
      ],
      "matches": [
        "https://tv.youtube.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://localhost:6767 wss://localhost:6767"
  },
  "icons": {
    "48": "assets/uburoom-icon-48.png",
    "96": "assets/uburoom-icon-96.png",
    "128": "assets/uburoom-icon-128.png"
  }
}
